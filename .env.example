# ==============================================================================
# AeroVantage X9 Drone Manual Assistant Configuration
# ==============================================================================

# LLM Provider API Keys
# Auto-detection priority: ANTHROPIC_API_KEY -> OPENAI_API_KEY -> GEMINI_API_KEY
# If none are provided or LLM fails, system falls back to deterministic extractive mode.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# LLM Model Configuration (Optional overrides; sensible defaults provided)
# Defaults:
# - Anthropic: claude-3-5-sonnet-latest
# - OpenAI: gpt-4o-mini
# - Gemini: gemini-2.5-flash
# LLM_MODEL=

# ChromaDB & Storage Settings
CHROMA_DB_DIR=./chroma_db
COLLECTION_NAME=drone_manual

# Path to PDF Technical Manual
PDF_PATH=./data/aerovantage_x9_drone_manual_50p.pdf
